# ==========================================
# Neon Hosted PostgreSQL Database URL
# ==========================================
# Obtain this from your Neon Console (https://console.neon.tech)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-voice-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000
