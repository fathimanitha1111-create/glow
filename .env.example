# ==========================================
# MySQL Database Configuration
# ==========================================
DB_NAME=simple_db
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=True

# In production, set DEBUG=False and add your domain:
ALLOWED_HOSTS=localhost,127.0.0.1,yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com,http://127.0.0.1:8000
