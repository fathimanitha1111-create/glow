# ==========================================
# Database Configuration (MySQL / TiDB Cloud)
# For TiDB Cloud Serverless:
# DB_HOST=gateway01.xxx.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxx.root
# DB_PASSWORD=your_password
# DB_NAME=test
# ==========================================
DB_NAME=simple_db
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=4000

# ==========================================
# Django Core Settings
# ==========================================
SECRET_KEY=generate-a-strong-secret-key-for-production
DEBUG=False

# Domains (Add your Vercel project domain here)
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

